# Copy to .env and edit. .env is gitignored.

# Folder holding daily_production.parquet, well_jobs.parquet, production_failures.parquet
DATA_DIR=data

# Cleaning thresholds
PLACEHOLDER_MIN=99999
MAX_RPM=1000
MAX_MOTOR_CURRENT_A=1000
MAX_PUMP_EFFICIENCY=1.5

# Scope
SCOPE_FLUID=Heavy Oil
SCOPE_FLOW=production

# Events
EVENT_GAP_DAYS=4
EVENT_GAP_DAYS_SENSITIVITY=7
MATCH_WINDOW_DAYS=7
VALIDATION_START=2025-07-01

# Sizing
QUICK_REPEAT_DAYS=30
REACTIVE_LOOKBACK_DAYS=14
REPAIR_JOB_CATEGORIES=Rod Truck,Workover
BBL_PER_M3=6.29
PARETO_CUTS=5,10,20,30,40,50,100
CURRENCY_LABEL=est., CAD assumed
CHECK_TOLERANCE=0.01

# Runs and features
PRE_WINDOW_PROD_DAYS=30
FAILS_PRIOR_DAYS=365
DISP_LOOKBACK_DAYS=60
JOB_LINK_DAYS_BEFORE=3
JOB_LINK_DAYS_AFTER=2

# Model training and evaluation
TIME_CUT=2025-01-01
COX_PENALIZER=0.01
HORIZON_DAYS=90
TOP_K=50
BOOTSTRAP_DRAWS=200
RANDOM_SEED=42
PH_TEST_ALPHA=0.01
CALIBRATION_BINS=10
INDEPENDENT_CHECK_DATE=2025-07-01
MIN_AT_RISK=30

# Economics
OIL_VALUE_PER_BBL=51.04
CSV_DECIMALS=4
